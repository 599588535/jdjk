<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="京东降价监控"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#E1251B"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="后台定时检查，低于目标价发系统通知 + 微信"
            android:textSize="12sp"
            android:textColor="#888888"
            android:layout_marginBottom="12dp" />

        <!-- 监控设置 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="监控设置"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="扫描间隔（小时，最短0.25）" android:textSize="13sp" android:layout_marginBottom="2dp" />
                <EditText
                    android:id="@+id/etInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="6"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="活跃时段 " android:textSize="13sp" android:layout_gravity="center_vertical" />
                    <EditText android:id="@+id/etStart" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:hint="9" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" – " android:layout_gravity="center_vertical" />
                    <EditText android:id="@+id/etEnd" android:layout_width="60dp" android:layout_height="wrap_content" android:inputType="number" android:hint="23" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" 点" android:layout_gravity="center_vertical" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="微信提醒（可选）：Server酱SendKey 或 PushPlus token，留空则只发系统通知" android:textSize="12sp" android:textColor="#999999" android:layout_marginBottom="2dp" />
                <EditText
                    android:id="@+id/etWxKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="形如 SCTxxxxx 或 PushPlus token"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="登录京东（获取账号专属价）"
                    style="?attr/materialButtonOutlinedStyle"
                    android:textColor="#E1251B" />
                <TextView
                    android:id="@+id/tvLoginStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未登录（将使用公开价）"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 添加商品 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加商品"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="商品名（如：小米14）"
                    android:layout_marginBottom="6dp" />
                <EditText
                    android:id="@+id/etUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="京东商品链接或商品ID（如 100012345678）"
                    android:layout_marginBottom="6dp" />
                <EditText
                    android:id="@+id/etTarget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="目标价格（低于此价提醒）"
                    android:layout_marginBottom="8dp" />
                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="＋ 添加商品"
                    android:backgroundTint="#E1251B"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 已监控商品 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已监控商品"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:id="@+id/llProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp" />

        <!-- 控制按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">
            <Button
                android:id="@+id/btnStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始监控"
                android:backgroundTint="#E1251B"
                android:textColor="#FFFFFF"
                android:layout_marginEnd="6dp" />
            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="停止"
                style="?attr/materialButtonOutlinedStyle" />
        </LinearLayout>
        <Button
            android:id="@+id/btnCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即检查一次"
            android:layout_marginBottom="12dp"
            style="?attr/materialButtonOutlinedStyle" />

        <!-- 日志 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运行日志"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="6dp" />
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:padding="10dp"
            android:textSize="11sp"
            android:textColor="#333333"
            android:lineSpacingExtra="2dp" />
        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空日志"
            android:layout_marginTop="6dp"
            style="?attr/materialButtonOutlinedStyle" />

    </LinearLayout>
</ScrollView>
